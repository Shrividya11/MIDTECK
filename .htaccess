# MIDTEK - Production Apache configuration
Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# HTTPS + non-www canonical host (change YOUR-DOMAIN.com if needed)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://midtek.com/%{REQUEST_URI} [R=301,L,NE]

# Clean URLs
RewriteRule ^about/?$ /about.html [L]
RewriteRule ^services/?$ /services.html [L]
RewriteRule ^contact/?$ /contact.html [L]
RewriteRule ^admin/?$ /admin.html [L]

# Avoid exposing source files
<FilesMatch "\.(env|log|sql|bak|old|orig|ini)$">
    Require all denied
</FilesMatch>

# Basic security headers
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

ErrorDocument 404 /404.html
